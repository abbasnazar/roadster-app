{
  "expo": {
    "name": "Roadster Relics Mobile",
    "slug": "roadster-relics-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "roadsterrelics",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
