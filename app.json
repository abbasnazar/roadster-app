        "backgroundColor": "#05090C"
      },
      "package": "com.roadsterrelics",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "95e284d1-34f9-47f0-875d-fc05ab27237b"
