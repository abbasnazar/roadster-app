# Backend API base URL — external Express server lives at
#   /home/syed/Documents/clone-roadster13feb/road/server (port 8080, 0.0.0.0)
# Pick the form that matches how you run the app:
#   - Physical device on LAN:  http://<host-lan-ip>:8080/api  (e.g. http://10.101.13.8:8080/api)
#   - Android emulator:        http://10.0.2.2:8080/api
#   - iOS simulator / web:     http://localhost:8080/api
#   - Production:              https://api.roadsterrelics.com/api
EXPO_PUBLIC_API_URL=http://localhost:8080/api

# Optional: home hero image (defaults to same GCS asset as web `road`)
# EXPO_PUBLIC_HOME_HERO_URL=https://storage.googleapis.com/images-road/ui-heroes/home-hero-marketplace-combined.jpg

# Optional: Google Sign-In on Expo web (Web OAuth client ID from Google Cloud Console)
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-client-id.apps.googleusercontent.com
